{
  "name": "securechain",
  "version": "1.0.0",
  "description": "Blockchain-Based Logistics Security and Shipment Verification Platform for MST Blockchain BUILDATHON 2.0",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "check-network": "hardhat run scripts/check-network.ts --network mstTestnet",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network mstTestnet",
    "dev": "npm --prefix frontend run dev",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "build": "hardhat compile && npm --prefix frontend run build"
  },
  "keywords": [
    "blockchain",
    "logistics",
    "solidity",
    "mst-blockchain",
    "supply-chain",
    "mst-buildathon"
  ],
  "author": "SecureChain Team",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@openzeppelin/contracts": "^5.0.2",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.3.16",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.12.7",
    "chai": "^4.4.1",
    "dotenv": "^16.4.5",
    "ethers": "^6.11.1",
    "hardhat": "^2.22.3",
    "hardhat-gas-reporter": "^1.0.10",
    "solidity-coverage": "^0.8.11",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.4.5"
  }
}
